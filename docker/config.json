{
  "log_level": "${MARGIT_LOG_LEVEL}",
  "store": {
    "type": "${MARGIT_STORE_TYPE}",
    "postgres": {
      "dsn": "${MARGIT_PG_DSN}",
      "bloom_expected": 1000000,
      "bloom_fp_rate": 0.01
    }
  },
  "engine": {
    "max_depth": 25,
    "lookup_default_limit": 100,
    "lookup_max_limit": 1000
  },
  "server": {
    "addr": ":8080",
    "read_timeout": "10s",
    "write_timeout": "30s",
    "shutdown_timeout": "15s"
  }
}
