{
  "log_level": "${MARGIT_LOG_LEVEL}",
  "store": {
    "type": "${MARGIT_STORE_TYPE}",
    "postgres": {
      "dsn": "${MARGIT_PG_DSN}",
      "bloom_expected": ${MARGIT_BLOOM_EXPECTED},
      "bloom_fp_rate": 0.01
    }
  },
  "engine": {
    "max_depth": ${MARGIT_MAX_DEPTH},
    "lookup_default_limit": 100,
    "lookup_max_limit": 1000,
    "response_cache": {
      "ttl_ms": ${MARGIT_CACHE_TTL_MS},
      "max_entries": ${MARGIT_CACHE_MAX_ENTRIES}
    }
  },
  "server": {
    "addr": ":8080",
    "read_timeout": "10s",
    "write_timeout": "30s",
    "shutdown_timeout": "15s"
  }
}
