{
  "log_level": "info",
  "store": {
    "type": "memory",
    "postgres": {
      "dsn": "${MARGIT_PG_DSN}",
      "bloom_expected": 1000000,
      "bloom_fp_rate": 0.01
    },
    "query_cache": {
      "ttl_ms": 0,
      "max_entries": 500000
    }
  },
  "engine": {
    "max_depth": 25,
    "lookup_default_limit": 100,
    "lookup_max_limit": 1000,
    "response_cache": {
      "ttl_ms": 0,
      "max_entries": 1000000
    }
  },
  "server": {
    "addr": ":8080",
    "read_timeout": "10s",
    "write_timeout": "30s",
    "shutdown_timeout": "15s"
  }
}
